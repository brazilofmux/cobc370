#!/bin/bash
# Compile one corpus program with cobc370 and link it into a separate loadlib,
# so it can be put ahead of the shipped ANS COBOL modules for comparison.
#
#   cobc-build <program> [loadlib]
#
# The shipped library is never touched. Modules land in SVD001.COBC370.LOADLIB,
# which is created on first use.
set -u
. "$(cd "$(dirname "$0")/../lib" && pwd)/common.sh"
prog=${1:?usage: cobc-build <program> [loadlib]}
lib=${2:-SVD001.COBC370.LOADLIB}
CC="$(cd "$(dirname "$0")/../cobol/cc" && pwd)"
SRC=$HOME/majesty/mvs/SVD001.DEFTLY.COBOL/$prog
WORK=${TMPDIR:-/tmp}/cobc-build; mkdir -p "$WORK"
[ -r "$SRC" ] || die "no such corpus program: $prog"

"$CC/cobc370" "$SRC" -o "$WORK/$prog.asm" || die "$prog did not compile"
say "$prog compiled: $(wc -l < "$WORK/$prog.asm" | tr -d ' ') lines of assembler"

{
cat <<EOF
//CBUILD   JOB (5161A020,1A11),'COBC370 BUILD',
//             CLASS=A,MSGCLASS=Z,MSGLEVEL=(1,1),
//             USER=HERC01,PASSWORD=@HERC01PW@
//* The library must already exist; see bin/cobc-lib-init. Creating it here
//* with IEFBR14 and DISP=(MOD,CATLG) cataloged it without ever writing a
//* DSCB, and the link then failed S213-04 on a name that resolved to nothing.
//S1      EXEC ASMFCL
//ASM.SYSIN DD  *
EOF
cat "$WORK/$prog.asm"
cat <<EOF
/*
//LKED.SYSLMOD DD  DSN=$lib($prog),DISP=SHR
EOF
} > "$WORK/$prog.jcl"

"$(dirname "$0")/tk5-run" "$WORK/$prog.jcl" "$WORK/$prog.out" >/dev/null 2>&1
asm=$(grep -a "IFOX00 *RC=" "$WORK/$prog.out" | sed 's/.*RC= *//' | head -1)
lked=$(grep -a "IEWL *RC=" "$WORK/$prog.out" | sed 's/.*RC= *//' | head -1)
say "$prog: assemble RC=${asm:-?}  link RC=${lked:-?}  -> $lib($prog)"
grep -a "\*\*\* ERROR\|IFO[0-9]\|IEW0" "$WORK/$prog.out" | head -8
[ "${asm:-8}" = "0000" ] && [ "${lked:-8}" = "0000" ]
