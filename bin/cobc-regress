#!/bin/bash
# Assemble, link and run every cobc370 test on the guest, and check each
# program's output against the GnuCOBOL oracle recorded beside it.
#
# Every slice so far has been verified this way, but by hand. Base locators
# touched every emit site at once and broke all eight tests, which is what
# made a scripted full-suite run worth having.
#
#   cobc-regress            run everything
#   cobc-regress arith      run one
set -u
. "$(cd "$(dirname "$0")/../lib" && pwd)/common.sh"
CC="$(cd "$(dirname "$0")/../src" && pwd)"
TDIR="$(cd "$(dirname "$0")/../tests" && pwd)"
WORK=${TMPDIR:-/tmp}/cobc-regress
mkdir -p "$WORK"

( cd "$CC" && make cobc370 >/dev/null ) || die "cobc370 will not build"

ALL="pgmchk godep currsign figlit condgrp arithgrp strings datetest bigdig grpredef litcont sections fdrecs advance sequpd declar setindex subs2d num2aln blkchar signclau justif wide18 pscale alnedit classcnd addser inspect alterst accept upsisw litmove ksdsnatl ksdsnat ksdsnats ksdsnatx ksdsnatu ksdsnatr esdsnatl esdsnatr esdsnatu esdsnata rrdsnatl rrdsnatr rrdsnats rrdsnatd rrdsdisp isamseq isamrnd figmove figval redef commatok qualify giving signcond intofrom srchall misc2 fltsign perftest rpttest edtest occmin stoprun hello arith compute grpperf iftest bigws filetest occtest"
TESTS=${*:-$ALL}

# The VSAM tests share a cluster and depend on the one that loads it: asking
# for ksdsnat alone gets a cluster holding whatever the last run left, and a
# confusing diff rather than a useful one. Pull the loader in when it is
# missing, in the order ALL declares.
prereq_for() {
    case "$1" in
        ksdsnat|ksdsnats|ksdsnatu|ksdsnatr|ksdsnatx) echo ksdsnatl ;;
        esdsnatr|esdsnatu|esdsnata)         echo esdsnatl ;;
        rrdsnatr|rrdsnatd|rrdsnats|rrdsdisp)         echo rrdsnatl ;;
    esac
}
if [ $# -gt 0 ]; then
    want=""
    for t in $TESTS; do
        p=$(prereq_for "$t")
        case " $want $TESTS " in
            *" $p "*) ;;
            *) [ -n "$p" ] && { want="$want $p"; say "  (adding $p: $t reads what it loads)"; } ;;
        esac
    done
    if [ -n "$want" ]; then
        ordered=""
        for t in $ALL; do
            case " $want $TESTS " in
                *" $t "*) ordered="$ordered $t" ;;
            esac
        done
        TESTS=$ordered
    fi
fi
pass=0; fail=0

for t in $TESTS; do
    [ -f "$TDIR/$t.cbl" ] || { say "$t: no such test"; fail=$((fail+1)); continue; }
    "$CC/cobc370" "$TDIR/$t.cbl" -o "$TDIR/$t.asm" || { say "$t: COMPILE FAILED"; fail=$((fail+1)); continue; }

    # column 72 is the continuation flag, never spare room
    if awk 'length($0)>72 || (length($0)==72 && substr($0,72,1)!="X")' "$TDIR/$t.asm" | grep -q .; then
        say "$t: COLUMN 72 VIOLATION"; fail=$((fail+1)); continue
    fi

    jn=$(echo "R$t" | tr 'a-z' 'A-Z' | cut -c1-8)
    {
        printf '//%-8s JOB (5161A020,1A11),%s,\n' "$jn" "'REGRESSION'"
        printf '//             CLASS=A,MSGCLASS=Z,MSGLEVEL=(1,1),\n'
        printf '//             USER=HERC01,PASSWORD=@HERC01PW@\n'
        if [ "$t" = upsisw ]; then
            # The switches arrive on the GO step's PARM, which is what the
            # runtime reads at entry.
            printf '//ASM      EXEC ASMFCLG,PARM.GO=%s\n' "'/UPSI(10100000)'"
        else
            printf '//ASM      EXEC ASMFCLG\n'
        fi
        printf '//ASM.SYSIN DD  *\n'
        cat "$TDIR/$t.asm"
        printf '/*\n//GO.SYSOUT  DD  SYSOUT=Z\n'
        case "$t" in isamseq|isamrnd)
            printf '//GO.GLACCT DD  DSN=SVD001.GLACCT,DISP=OLD,UNIT=3380,VOL=SER=SVD003\n' ;;
        ksdsnat|ksdsnatl|ksdsnatu|ksdsnatr|ksdsnats|ksdsnatx)
            # The VSAM trio is stateful and runs in this order: ksdsnatl loads
            # the cluster, ksdsnat reads back what it wrote, ksdsnatu updates
            # it in place, ksdsnatr adds and deletes by key. ksdsnats only
            # reads, so it sits with the readers; the two that change the
            # cluster come last, which is why
            # the cluster changed, and the next pass starts by loading it. The
            # cluster is defined REUSE, so the load empties it at OPEN OUTPUT
            # and the pair can be re-run any number of times without the
            # DELETE/DEFINE that once cost this system its user catalog.
            printf '//GO.KSDSF01 DD  DSN=VSTEST.KSDS.CLUSTER,DISP=OLD\n' ;;
        esac
        if [ "$t" = ksdsnatl ]; then
            printf '//GO.IMAGES  DD  DSN=SVD001.VSAMTEST.DATA,DISP=SHR\n'
        fi
        case "$t" in esdsnatl|esdsnatr|esdsnatu|esdsnata)
            # The ESDS fixtures live in UCVSTEST on WORK01, reached through
            # the VSTEST alias in the master catalog -- never in the user's
            # own catalog, where DEFINE CLUSTER has a habit of being fatal.
            # Order is load, read, update, extend: the load is REUSE/RST so
            # it empties the cluster and the group is repeatable.
            printf '//GO.ESDSF01 DD  DSN=VSTEST.ESDS.CLUSTER,DISP=OLD\n' ;;
        esac
        case "$t" in rrdsnatl|rrdsnatr|rrdsnatd|rrdsnats|rrdsdisp)
            printf '//GO.RRDSF01 DD  DSN=VSTEST.RRDS.CLUSTER,DISP=OLD\n' ;;
        esac
        if [ "$t" = rrdsnatl ] || [ "$t" = esdsnatl ]; then
            printf '//GO.IMAGES  DD  DSN=SVD001.VSAMTEST.DATA,DISP=SHR\n'
        fi
        if [ "$t" = esdsnata ]; then
            printf '//GO.CARDIN  DD  *\n'
            cat "$TDIR/data/esds-extend.txt"
            printf '/*\n'
        fi
        if [ "$t" = rrdsnatd ]; then
            printf '//GO.CARDIN  DD  *\n'
            cat "$TDIR/data/rrds-actions.txt"
            printf '/*\n'
        fi
        if [ "$t" = ksdsnatr ]; then
            printf '//GO.CARDIN  DD  *\n'
            cat "$TDIR/data/ksds-actions.txt"
            printf '/*\n'
        fi
        if [ "$t" = rpttest ]; then printf '//GO.PROUT   DD  SYSOUT=Z\n'; fi
        if [ "$t" = intofrom ]; then
            printf '//GO.OUTFILE DD  SYSOUT=Z\n//GO.INFILE  DD  *\n'
            for r in "AAA111 first record" "BBB222 second record" \
                     "CCC333 third record" "DDD444 fourth record"; do
                printf '%-72s\n' "$r"
            done
            printf '/*\n'
        fi
        if [ "$t" = fdrecs ]; then printf '//GO.OUTFILE DD  SYSOUT=Z\n'; fi
        if [ "$t" = upsisw ]; then printf '//GO.SYSIN   DD  DUMMY\n'; fi
        if [ "$t" = accept ]; then
            printf '//GO.SYSIN   DD  *\n'
            printf '%-72s\n' "FIRST CARD" "SECOND CARD"
            printf '/*\n'
        fi
        if [ "$t" = declar ]; then
            printf '//GO.INFILE  DD  *\n'
            for r in "FIRST RECORD" "SECOND RECORD" "THIRD RECORD"; do
                printf '%-72s\n' "$r"
            done
            printf '/*\n'
        fi
        if [ "$t" = blkchar ]; then
            printf '//GO.BLKFILE DD  DSN=&&BLK,DISP=(NEW,PASS),UNIT=SYSDA,\n'
            printf '//             SPACE=(TRK,(1,1))\n'
        fi
        if [ "$t" = sequpd ]; then
            printf '//GO.UPDFILE DD  DSN=&&UPD,DISP=(NEW,PASS),UNIT=SYSDA,\n'
            printf '//             SPACE=(TRK,(1,1))\n'
        fi
        if [ "$t" = advance ]; then
            printf '//GO.PRTFILE DD  DSN=&&PRT,DISP=(NEW,PASS),UNIT=SYSDA,\n'
            printf '//             SPACE=(TRK,(1,1))\n'
        fi
        if [ "$t" = filetest ]; then
            printf '//GO.OUTFILE DD  SYSOUT=Z\n//GO.INFILE  DD  *\n'
            for r in "RECORD ONE" "RECORD TWO" "RECORD THREE" "RECORD FOUR"; do
                printf '%-72s\n' "$r"
            done
            printf '/*\n'
        fi
    } > "$WORK/$t.jcl.new" && mv "$WORK/$t.jcl.new" "$WORK/$t.jcl"

    run_deck "$WORK/$t.jcl" "$WORK/$t.out"
    # check the assembler first: an assembly error otherwise surfaces later as
    # a bewildering abend rather than as the diagnostic it is
    arc=$(grep -oE 'IFOX00    RC= [0-9]+' "$WORK/$t.out" | tail -1 | grep -oE '[0-9]+$')
    if [ "${arc:-x}" != "0000" ]; then
        say "  $t: ASSEMBLY RC=${arc:-none}"
        grep -oE 'IFO[0-9]+ +.*' "$WORK/$t.out" | sort -u | head -3 | sed 's/^/      /'
        fail=$((fail+1)); continue
    fi
    # Take the LAST GO-step result line, whatever it says. JES2 prints spool
    # asynchronously, so a previous job's output can land after the offset mark
    # for this one -- grepping for any abend anywhere then reports a stale
    # failure against a job that actually succeeded.
    res=$(grep -oE 'PGM=\*\.DD +(RC= [0-9]+|AB [SU][0-9A-F]+)' "$WORK/$t.out" | tail -1)
    # One test is supposed to fail: pgmchk feeds an ADD a field holding 'ABC'
    # and exists to prove the program-check exit names the right line. It ends
    # U3007 -- 3000 plus the interruption code -- and anything else is wrong,
    # including running to completion.
    case "$t" in
        pgmchk)
            case "$res" in
                *"AB U3007") ;;
                *) say "  $t: expected AB U3007, got '${res##*DD }'"
                   fail=$((fail+1)); continue ;;
            esac ;;
        *)
            case "$res" in
                *"RC= 0000") ;;
                "")          say "  $t: no GO step"; fail=$((fail+1)); continue ;;
                *)           say "  $t: ${res##*DD }"; fail=$((fail+1)); continue ;;
            esac ;;
    esac

    if [ -f "$TDIR/$t.expected" ]; then
        # The expected lines must appear consecutively; JES2 separator pages
        # are full of block letters that match almost any loose pattern.
        if python3 - "$TDIR/$t.expected" "$WORK/$t.out" <<'PY'
import sys
# Blank lines are carriage control, not content: a report pads to its page
# boundary on one side and ejects on the other. Compare the content.
import re
# The program-check message carries the interrupt offset in hex. That is the
# one thing in any oracle that legitimately moves whenever code generation
# changes, so it is masked on both sides rather than frozen.
def norm(l):
    return re.sub(r'OFFSET [0-9A-F]{6}', 'OFFSET ......', l.rstrip())
exp = [norm(l) for l in open(sys.argv[1], errors="replace").read().splitlines() if l.strip()]
# An empty oracle matches everything -- any(got[i:i+0] == []) is true at every
# offset -- so a truncated or half-written .expected would turn into a silent
# pass on every future run. Agreement with nothing is not agreement.
if not exp:
    sys.stderr.write("oracle %s has no content lines\n" % sys.argv[1]); sys.exit(2)
got = [norm(l) for l in open(sys.argv[2], errors="replace").read().splitlines() if l.strip()]
sys.exit(0 if any(got[i:i+len(exp)] == exp for i in range(len(got)-len(exp)+1)) else 1)
PY
        then say "  $t: ok (matches oracle)"; pass=$((pass+1))
        else say "  $t: OUTPUT DIFFERS FROM ORACLE"; fail=$((fail+1)); fi
    else
        say "  $t: ok (ran clean; no oracle recorded)"; pass=$((pass+1))
    fi
done

# The ISAM round trip needs a multi-step job -- create in one step, read in a
# later one -- which this single-job harness cannot express, so it lives in its
# own script. Run it only on a full sweep.
if [ $# -eq 0 ]; then
    if "$(dirname "$0")/cobc-isam-roundtrip" >/dev/null 2>&1
    then say "  isam-roundtrip: ok (QISAM load, then read back)"; pass=$((pass+1))
    else say "  isam-roundtrip: FAILED"; fail=$((fail+1)); fi
    if "$(dirname "$0")/cobc-call-roundtrip" >/dev/null 2>&1
    then say "  call-roundtrip: ok (separate compile, linked, parameters both ways)"; pass=$((pass+1))
    else say "  call-roundtrip: FAILED"; fail=$((fail+1)); fi
fi

say ""
say "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
