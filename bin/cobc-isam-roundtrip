#!/bin/bash
# Prove QISAM load mode end to end: create an ISAM dataset with cobc370's
# output, then read it back with cobc370's output.
#
# This cannot live in cobc-regress, which builds a single ASM/LKED/GO job per
# test. An ISAM dataset has to be created in one step and read in a later one,
# because allocation happens at step start and the dataset does not exist yet.
set -u
. "$(cd "$(dirname "$0")/../lib" && pwd)/common.sh"
CC="$(cd "$(dirname "$0")/../src" && pwd)"
TDIR="$(cd "$(dirname "$0")/../tests" && pwd)"
WORK=${TMPDIR:-/tmp}/cobc-isam; mkdir -p "$WORK"
DSN=SVD001.TESTIDX
DSN2=SVD001.TESTIDX2

"$CC/cobc370" "$TDIR/isamload.cbl" > "$TDIR/isamload.asm" || die "isamload did not compile"
"$CC/cobc370" "$TDIR/isamrd2.cbl"  > "$TDIR/isamrd2.asm"  || die "isamrd2 did not compile"
"$CC/cobc370" "$TDIR/isamstat.cbl" > "$TDIR/isamstat.asm" || die "isamstat did not compile"
"$CC/cobc370" "$TDIR/isamrnf.cbl"  > "$TDIR/isamrnf.asm"  || die "isamrnf did not compile"

{
cat <<EOF
//ISAMRT   JOB (5161A020,1A11),'ISAM ROUNDTRIP',
//             CLASS=A,MSGCLASS=Z,MSGLEVEL=(1,1),
//             USER=HERC01,PASSWORD=@HERC01PW@
//* 1. clear any leftover. MOD so the step works whether or not it exists.
//S1      EXEC PGM=IEFBR14
//DSN2DEL  DD  DSN=$DSN,DISP=(MOD,DELETE,DELETE),
//             UNIT=3380,VOL=SER=SVD003
//* 2. create and load it, ascending key order
//S2      EXEC ASMFCLG
//ASM.SYSIN DD  *
EOF
cat "$TDIR/isamload.asm"
cat <<EOF
/*
//GO.SYSOUT  DD  SYSOUT=Z
//GO.DESCIDX DD  DSNAME=$DSN(INDEX),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,1),
//             DCB=(DSORG=IS,RECFM=F)
//           DD  DSNAME=$DSN(PRIME),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,2),DCB=*.DESCIDX
//           DD  DSNAME=$DSN(OVFLOW),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,1),DCB=*.DESCIDX
//GO.DESCIN  DD  *
EOF
for k in 0000000100 0000000205 0000000310 0000000420 0000000999; do
    printf '%s%-70s\n' "$k" "DESCRIPTION FOR $k"
done
cat <<EOF
/*
//* 3. read it back. ASMFCLG's SYSLMOD is &&GOSET(GO); a second ASMFCLG in
//*    the same job cannot store another member called GO, so give S3 its own
//*    library or PGM=*.LKED.SYSLMOD silently re-runs the loader.
//S3      EXEC ASMFCLG
//ASM.SYSIN DD  *
EOF
cat "$TDIR/isamrd2.asm"
cat <<EOF
/*
//LKED.SYSLMOD DD DSN=&&GOSET2(GO),UNIT=SYSDA,
//             SPACE=(1024,(50,20,1)),DISP=(MOD,PASS)
//GO.SYSOUT  DD  SYSOUT=Z
//* No DCB= here: OPEN takes every attribute from the label. Coding
//* RECFM=F against a dataset the loader blocked as FB gives S03B.
//GO.DESCIDX DD  DSNAME=$DSN,DISP=(OLD,KEEP),
//             VOL=SER=SVD003,UNIT=3380
//* 4. leave the volume as we found it
//S4      EXEC PGM=IEFBR14
//DSN2DEL  DD  DSN=$DSN,DISP=(MOD,DELETE,DELETE),
//             UNIT=3380,VOL=SER=SVD003
//* 5. FILE STATUS in load mode: a second scratch dataset takes a clean
//*    write, a duplicate (22), a key out of sequence (21), and one more
//*    clean write to show loading continues.
//S5      EXEC PGM=IEFBR14
//DSN3DEL  DD  DSN=$DSN2,DISP=(MOD,DELETE,DELETE),
//             UNIT=3380,VOL=SER=SVD003
//S6      EXEC ASMFCLG
//ASM.SYSIN DD  *
EOF
cat "$TDIR/isamstat.asm"
cat <<EOF
/*
//LKED.SYSLMOD DD DSN=&&GOSET3(GO),UNIT=SYSDA,
//             SPACE=(1024,(50,20,1)),DISP=(MOD,PASS)
//GO.SYSOUT  DD  SYSOUT=Z
//GO.DESCIDX DD  DSNAME=$DSN2(INDEX),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,1),
//             DCB=(DSORG=IS,RECFM=F)
//           DD  DSNAME=$DSN2(PRIME),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,2),DCB=*.DESCIDX
//           DD  DSNAME=$DSN2(OVFLOW),DISP=(,KEEP),UNIT=3380,
//             VOL=SER=SVD003,SPACE=(CYL,1),DCB=*.DESCIDX
//* 6. FILE STATUS on a BISAM random read: found (00), missing (23).
//S7      EXEC ASMFCLG
//ASM.SYSIN DD  *
EOF
cat "$TDIR/isamrnf.asm"
cat <<EOF
/*
//LKED.SYSLMOD DD DSN=&&GOSET4(GO),UNIT=SYSDA,
//             SPACE=(1024,(50,20,1)),DISP=(MOD,PASS)
//GO.SYSOUT  DD  SYSOUT=Z
//GO.DESCIDX DD  DSNAME=$DSN2,DISP=(OLD,KEEP),
//             VOL=SER=SVD003,UNIT=3380
//* 7. leave the volume as we found it
//S8      EXEC PGM=IEFBR14
//DSN3DEL  DD  DSN=$DSN2,DISP=(MOD,DELETE,DELETE),
//             UNIT=3380,VOL=SER=SVD003
EOF
} > "$WORK/roundtrip.jcl"

run_deck "$WORK/roundtrip.jcl" "$WORK/roundtrip.out"
grep -a "^DESCIDX LOADED\|^BACK \|^DUPLICATE\|^W[0-9] \|^IK[0-9] \|^R[0-9] " "$WORK/roundtrip.out" > "$WORK/got.txt"

exp="$TDIR/isamroundtrip.expected"
if [ ! -r "$exp" ]; then
    cp "$WORK/got.txt" "$exp"; say "recorded oracle -> $exp"; exit 0
fi
if diff -q "$exp" "$WORK/got.txt" >/dev/null; then
    say "isam roundtrip: ok (load and read back both match oracle)"
    exit 0
fi
say "isam roundtrip: FAILED"
diff "$exp" "$WORK/got.txt" | head -20
exit 1
